# Anime API Configuration
# Jikan API - Free unofficial MyAnimeList API (No API key required)
NEXT_PUBLIC_JIKAN_API_URL=https://api.jikan.moe/v4

# Future API configurations can be added here
# Example:
# KITSU_API_URL=https://kitsu.io/api/edge
# ANILIST_API_URL=https://graphql.anilist.co

# Feature flags
# Set to 'true' to use local fallback data instead of API
NEXT_PUBLIC_USE_FALLBACK_DATA=false
